{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RSS Reader",
  "version": "0.2.0",
  "identifier": "software.krill.rss-reader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RSS Reader",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 480,
        "decorations": false,
        "resizable": true,
        "center": true,
        "backgroundColor": "#FAFAFF"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "cli": {
      "description": "A minimal RSS reader for Linux",
      "args": [
        {
          "name": "file",
          "index": 1,
          "takesValue": true,
          "description": "Path to a .opml file to open"
        }
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3Nzg5QTc4MEExOTM4MjIKUldRaU9Ca0tlSnA0aDQzcXJLRWtKWTI0K0lDM3IwTW4wcGUzdFZ5RE01ckYraU5nL1FRZWRXRmgK",
      "endpoints": [
        "https://github.com/krill-software/rss-reader/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "RSS reader",
    "longDescription": "A minimal RSS / Atom reader for Linux. One OPML file per window. Three columns. No accounts, no daemon, no cloud.",
    "fileAssociations": [
      {
        "ext": ["opml"],
        "name": "OPML subscription list",
        "description": "OPML subscription list",
        "mimeType": "text/x-opml",
        "role": "Editor"
      }
    ],
    "linux": {
      "deb": {
        "section": "net",
        "priority": "optional",
        "desktopTemplate": "main.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
